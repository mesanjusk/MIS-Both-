PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mis
ACCESS_TOKEN_SECRET=replace_with_jwt_secret
# Must stay a fixed value across deploys — regenerating it logs every user out at once.
# How long a login session lasts (jsonwebtoken "expiresIn" format, e.g. 45d, 90d).
JWT_EXPIRY=45d

# WhatsApp
#
# Outbound WhatsApp sending is NOT configured here. Every outbound message —
# automation and manual alike — goes through the SanjuSK API, whose key and
# webhook secret are saved (encrypted) at runtime under Admin → API. There is no
# env-based Meta send credential and no fallback; a missing SanjuSK key is a
# hard, visible error at send time.
#
# The variables below cover the parts that still live in the environment:
#   - Inbound webhook auth (the legacy Meta webhook + the SanjuSK/Metabsp one).
#   - Encryption of the SanjuSK credentials at rest.
#   - Meta Graph reads still used for template listing + Social (IG/FB) OAuth.

# Meta Graph — Social (Instagram/Facebook) OAuth and WhatsApp template reads.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_API_VERSION=v18.0

# Legacy Meta inbound webhook (POST /webhook): verify token for the GET
# handshake, and signature enforcement (fails closed unless set to false).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_webhook_verify_token
WHATSAPP_ENFORCE_WEBHOOK_SIGNATURE=true

# AES-256-GCM key used to encrypt the SanjuSK API key + webhook secret at rest.
WHATSAPP_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key

# SanjuSK/Metabsp inbound webhook (POST /webhook/metabsp) HMAC secret. Optional
# fallback: the secret can instead be saved from Admin → API (stored encrypted),
# which takes precedence over this env var when present.
METABSP_WEBHOOK_SECRET=your_metabsp_destination_secret

OWNER_WHATSAPP_NUMBER=91XXXXXXXXXX

# Google OAuth (shared for Drive + Gmail — same Google Cloud project credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://misbackend-e078.onrender.com/api/google-drive/callback

# Gmail Multi-Account Integration
# Add GMAIL_REDIRECT_URI in Google Cloud Console → Credentials → OAuth 2.0 → Authorized redirect URIs
GMAIL_REDIRECT_URI=https://misbackend-e078.onrender.com/api/gmail/callback
# Optional: Google Drive folder ID where large files (>24MB) are uploaded before emailing a link
GMAIL_DRIVE_FOLDER_ID=

# Frontend URL (used to redirect browser back after Gmail OAuth connect)
FRONTEND_URL=https://dash.sanjusk.in

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://dash.sanjusk.in

# Internal cron key
INTERNAL_API_KEY=replace_with_random_secret

# Google Gemini API — reused by Diary OCR and read-only Office AI.
# Office AI falls back to deterministic MIS rules when the key is absent/unavailable.
GEMINI_API_KEY=your_gemini_api_key
# Optional Office AI model override. If empty, GEMINI_TEXT_MODEL is used when set,
# otherwise the backend-compatible default is used.
GEMINI_OFFICE_MODEL=
GEMINI_TEXT_MODEL=

# Cloudinary (media storage — used by WhatsApp media + Social Media assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Social Media module ──────────────────────────────────────────────────────
# Base64-encoded 32-byte AES-256-GCM key for encrypting social platform OAuth
# tokens at rest (separate from WHATSAPP_TOKEN_ENCRYPTION_KEY above). Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key

# Meta (Instagram + Facebook Pages) — reuses META_APP_ID/META_APP_SECRET/
# META_API_VERSION already configured above for WhatsApp Cloud API.
META_REDIRECT_URI=https://misbackend-e078.onrender.com/api/social/providers/meta/callback

# YouTube — reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET already configured
# above for Drive/Gmail; only needs its own redirect URI + upload scopes.
# NOTE: uploads may be restricted (private/unlisted only) until this Google
# Cloud project passes YouTube API audit/verification — shown in the UI.
YOUTUBE_REDIRECT_URI=https://misbackend-e078.onrender.com/api/social/providers/youtube/callback

# LinkedIn (organization/company page posting — requires Community
# Management API product access approved by LinkedIn for this app)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://misbackend-e078.onrender.com/api/social/providers/linkedin/callback

# TikTok Content Posting API (public posting requires TikTok app audit —
# unaudited apps are restricted to "Only Me" visibility, shown in the UI)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://misbackend-e078.onrender.com/api/social/providers/tiktok/callback